# Copy to backend/.env and adjust. All values optional.
FOLIO_DATA_DIR=data
FOLIO_MAX_UPLOAD_BYTES=524288000
FOLIO_FILE_TTL_SECONDS=86400
FOLIO_JOB_WORKERS=4
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
FOLIO_SOFFICE_BIN=
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
FOLIO_TESSERACT_BIN=
FOLIO_OCR_LANGUAGES=eng

# ---- Accounts & billing (hosted edition) ----
# false = self-hosted open-source edition: everything unlocked, accounts optional.
FOLIO_BILLING_ENABLED=false
# Empty = sqlite:///<data_dir>/folio.db (self-hosted / desktop).
# Supabase Postgres: Project Settings > Database > Connect > "Session pooler" URI, with [YOUR-PASSWORD]
# replaced by your database password. Paste it as is: postgresql:// is rewritten to the pure-Python
# pg8000 driver, and Folio's tables are created in their own "folio" schema on first start.
#   FOLIO_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
FOLIO_DATABASE_URL=
# Optional: path to the Supabase CA certificate (Project Settings > Database > SSL configuration >
# Download certificate) so the TLS certificate is verified. Without it the connection is still
# encrypted, but not verified.
FOLIO_DATABASE_SSL_ROOT_CERT=
# true only behind a trusted reverse proxy: use the first X-Forwarded-For hop as the client IP.
FOLIO_TRUST_PROXY=false

# ---- Accounts (Supabase Auth) ----
# Accounts are enabled whenever FOLIO_SUPABASE_URL is set (independently of FOLIO_BILLING_ENABLED).
# Project Settings > Data API (or the "Connect" dialog) > Project URL.
FOLIO_SUPABASE_URL=https://hbfhsiimxscqdqbgbwag.supabase.co
# Project Settings > API Keys > Publishable key (sb_publishable_...). Public; also served to the
# frontend by GET /api/auth/config.
FOLIO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_6seLeHmbPhL1zYrK4AYg_A_yzp1k6uJ
# Project Settings > API Keys > Secret keys (starts with sb_secret_). KEEP IT PRIVATE: never commit it
# or put it in the frontend. Optional, but needed to delete accounts and to check whether a user has
# two-factor authentication when the database is not Supabase Postgres.
FOLIO_SUPABASE_SECRET_KEY=
# Audience of Supabase access tokens (leave as is).
FOLIO_SUPABASE_JWT_AUDIENCE=authenticated
# Billing, account deletion and API-key management require the authenticator code (aal2) for
# users who set up two-factor authentication.
FOLIO_REQUIRE_MFA_FOR_SENSITIVE=true

# Public URL of the frontend (checkout success redirect: <public_url>/account?checkout=success).
FOLIO_PUBLIC_URL=http://localhost:5173

# Paddle Billing. sandbox -> https://sandbox-api.paddle.com, production -> https://api.paddle.com
FOLIO_PADDLE_ENVIRONMENT=sandbox
# Paddle > Developer tools > Authentication > Client-side tokens (test_... in sandbox, live_... in production)
FOLIO_PADDLE_CLIENT_TOKEN=
# Paddle > Developer tools > Authentication > API keys (needs customer/subscription/transaction read+write,
# customer_portal_session write)
FOLIO_PADDLE_API_KEY=
# Paddle > Developer tools > Notifications > your destination > secret key (pdl_ntfset_...)
FOLIO_PADDLE_WEBHOOK_SECRET=
# Price ids (pri_...) from Paddle > Catalog > Products
FOLIO_PADDLE_PRICE_PLUS_MONTHLY=
FOLIO_PADDLE_PRICE_PLUS_YEARLY=
FOLIO_PADDLE_PRICE_PRO_MONTHLY=
FOLIO_PADDLE_PRICE_PRO_YEARLY=
FOLIO_PADDLE_PRICE_MAX_MONTHLY=
FOLIO_PADDLE_PRICE_MAX_YEARLY=
# Display only; configure the actual trial on each Paddle price.
FOLIO_TRIAL_DAYS=7
