# Copy to backend/.env and adjust. All values optional.
FOLIO_DATA_DIR=data
FOLIO_MAX_UPLOAD_BYTES=524288000
FOLIO_FILE_TTL_SECONDS=86400
FOLIO_JOB_WORKERS=4
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
FOLIO_SOFFICE_BIN=
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
FOLIO_TESSERACT_BIN=
FOLIO_OCR_LANGUAGES=eng
