# Copy to backend/.env and adjust. All values optional.
FOLIO_DATA_DIR=data
FOLIO_MAX_UPLOAD_BYTES=524288000
FOLIO_FILE_TTL_SECONDS=86400
FOLIO_JOB_WORKERS=4
# Windows example: C:\Program Files\LibreOffice\program\soffice.exe
FOLIO_SOFFICE_BIN=
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
FOLIO_TESSERACT_BIN=
FOLIO_OCR_LANGUAGES=eng

# ---- Accounts & billing (hosted edition) ----
# false = self-hosted open-source edition: everything unlocked, accounts optional.
FOLIO_BILLING_ENABLED=false
# Default: sqlite:///<data_dir>/folio.db. Postgres: postgresql+psycopg://user:pass@host:5432/folio
FOLIO_DATABASE_URL=
# Signs session cookies. Empty = generated once and stored in <data_dir>/.secret_key.
# Set explicitly when running several instances. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
FOLIO_SECRET_KEY=
FOLIO_SESSION_DAYS=30
# true in production (HTTPS) so the session cookie is Secure.
FOLIO_COOKIE_SECURE=false
# true only behind a trusted reverse proxy: use the first X-Forwarded-For hop as the client IP.
FOLIO_TRUST_PROXY=false
# Public URL of the frontend (checkout success redirect: <public_url>/account?checkout=success).
FOLIO_PUBLIC_URL=http://localhost:5173

# Paddle Billing. sandbox -> https://sandbox-api.paddle.com, production -> https://api.paddle.com
FOLIO_PADDLE_ENVIRONMENT=sandbox
# Paddle > Developer tools > Authentication > Client-side tokens (test_... in sandbox, live_... in production)
FOLIO_PADDLE_CLIENT_TOKEN=
# Paddle > Developer tools > Authentication > API keys (needs customer/subscription/transaction read+write,
# customer_portal_session write)
FOLIO_PADDLE_API_KEY=
# Paddle > Developer tools > Notifications > your destination > secret key (pdl_ntfset_...)
FOLIO_PADDLE_WEBHOOK_SECRET=
# Price ids (pri_...) from Paddle > Catalog > Products
FOLIO_PADDLE_PRICE_PLUS_MONTHLY=
FOLIO_PADDLE_PRICE_PLUS_YEARLY=
FOLIO_PADDLE_PRICE_PRO_MONTHLY=
FOLIO_PADDLE_PRICE_PRO_YEARLY=
FOLIO_PADDLE_PRICE_MAX_MONTHLY=
FOLIO_PADDLE_PRICE_MAX_YEARLY=
# Display only; configure the actual trial on each Paddle price.
FOLIO_TRIAL_DAYS=7
